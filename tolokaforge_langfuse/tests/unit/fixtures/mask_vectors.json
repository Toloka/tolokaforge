      "input": "{\"out\": \"X=1\\nPGPASSWORD=Fake8chrValue99\"}",
      "known": [],
      "also": [],
      "expected": "{\"out\": \"X=1\\nPGPASSWORD=MASKED\"}",
      "counts": {
        "dotenv-secret": 1
      }
    },
    {
