{
  "about": "Shared masking vectors: one row per case, fake secrets as {TOKEN} placeholders that each test expands at run time; a row with withheld names the rule its unit is withheld with. Kept byte-identical wherever it is copied.",
  "placeholder": "MASKED",
  "tokens": [
    "AT_PW",
    "EARLY_AT_PW",
    "GH_PAT",
    "GLPAT",
    "HEX40",
    "LEAD_AT_PW",
    "PEM_BEGIN",
    "PEM_END",
    "PG",
    "SK_ANT",
    "SK_OR",
    "SLACK",
    "URL_PW"
  ],
  "rows": [
    {
      "id": "dotenv-hash-tail",
      "case": "an unquoted dotenv value runs to the line end, past a hash sign",
      "kind": "bytes",
      "input": "DB_PASSWORD=Fake8chr#TailSecretXYZ123\nNEXT=1\n",
      "known": [],
      "also": [],
      "expected": "DB_PASSWORD=MASKED\nNEXT=1\n",
      "counts": {
        "dotenv-secret": 1
      }
    },
    {
      "id": "dotenv-quoted-spaces",
      "case": "a quoted dotenv value runs to its closing quote, spaces included; the quotes stay",
      "kind": "bytes",
      "input": "SERVICE_API_KEY=\"fakehorsey battery staple tail\"\n",
      "known": [],
      "also": [],
      "expected": "SERVICE_API_KEY=\"MASKED\"\n",
      "counts": {
        "dotenv-secret": 1
      }
    },
    {
      "id": "dotenv-escaped-break",
      "case": "an escaped line break ends an unquoted dotenv value and starts the next line",
      "kind": "bytes",
      "input": "A=1\\nPGPASSWORD=postgres-fake-01\\nB=2",
      "known": [],
      "also": [],
      "expected": "A=1\\nPGPASSWORD=MASKED\\nB=2",
      "counts": {
        "dotenv-secret": 1,
        "secret-field": 1
      }
    },
    {
      "id": "dotenv-escaped-backslash",
      "case": "an escaped backslash followed by n is no line break: the whole value is masked",
      "kind": "bytes",
      "input": "DB_PASSWORD=C0rp\\\\new-Pw-Fake-Tail9\nNEXT=1\n",
      "known": [],
      "also": [],
      "expected": "DB_PASSWORD=MASKED\nNEXT=1\n",
      "counts": {
        "dotenv-secret": 1
      }
    },
    {
      "id": "dotenv-escaped-break-ambiguous",
      "case": "an escaped line break followed by more of the value, not a new line: withheld",
      "kind": "bytes",
      "input": "API_KEY=aaaaaaaa\\nS3cr3tV4lue9bX7qZ2mNpQrTuVwXy\\n",
      "known": [],
      "also": [],
      "expected": "API_KEY=MASKED\\nS3cr3tV4lue9bX7qZ2mNpQrTuVwXy\\n",
      "counts": {
        "dotenv-secret": 1
      },
      "withheld": "mask-residue"
    },
    {
      "id": "dotenv-last-in-json-string",
