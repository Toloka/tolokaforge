{
    "$id": "https://ulb-h/schemas/metrics.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "latency_total_s": {"type": "number"},
        "turns": {"type": "integer"},
        "api_calls": {"type": "integer"},
        "usage": {
            "type": "object",
            "description": "Full Usage accounting (prompt / completion / reasoning / cache) from tolokaforge.core.llm.usage.Usage. See docs/LLM_LAYER.md.",
            "properties": {
                "prompt_tokens": {"type": "integer"},
                "completion_tokens": {"type": "integer"},
                "reasoning_tokens": {"type": "integer"},
                "cached_tokens": {"type": "integer"},
                "cache_creation_input_tokens": {"type": "integer"},
                "cache_read_input_tokens": {"type": "integer"},
                "provider_raw": {"type": "object"},
                "calls": {"type": "array"}
            }
        },
        "cost_usd": {"type": ["number", "null"]},
        "tool_calls": {"type": "integer"},
        "tool_success_rate": {"type": "number"},
        "stuck_detected": {"type": "boolean"},
        "tool_usage": {"type": "array"},
        "rate_limit_retries": {
            "type": "integer",
            "description": "429 retries absorbed by rate-limit probe mode. 0 on every non-probe run."
        },
        "rate_limit_wait_s": {
            "type": "number",
            "description": "Summed retry sleep scheduled for those retries. Non-zero means latency_total_s includes 429 sleep and is not comparable with a normal run."
        },
        "rate_limit_first_ts": {"type": ["string", "null"], "format": "date-time"},
        "rate_limit_last_ts": {"type": ["string", "null"], "format": "date-time"},
        "rate_limit_by_role_model": {
            "type": "array",
            "description": "Per-(role, model slug) breakdown of the same 429s; the flat rate_limit_* fields are the sum across these rows. Empty on every non-probe run.",
            "items": {
                "type": "object",
                "properties": {
                    "role": {"type": "string"},
                    "model": {"type": "string"},
                    "retries": {"type": "integer"},
                    "wait_s": {"type": "number"},
                    "first_ts": {"type": ["string", "null"], "format": "date-time"},
                    "last_ts": {"type": ["string", "null"], "format": "date-time"}
                },
                "required": ["role", "model"]
            }
        }
    },
    "required": ["latency_total_s", "turns", "tool_calls"]
}
