# Standalone tolokaforge stack — environment template.
#
# Copy to `.env` (same directory as docker-compose.yaml) before
# `docker compose up`. docker compose auto-loads this `.env` for interpolation.
# A keyless bring-up (health check only) needs no `.env`; real (paid) trials
# need a provider key below.

# Which published image tag to run. Defaults to `latest` when unset.
#   latest        published rolling tag (needs the first publish, image-v0.11.0)
#   0.11.0        a pinned published release
#   local         developer's locally-built tolokasoft1/tolokaforge-*:local images
TOLOKAFORGE_IMAGE_TAG=latest

# --- LLM provider credentials -------------------------------------------------
# Set the key for the provider your task's models route to. OpenRouter is the
# common default; the sibling keys cover direct-provider routing.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Multi-provider alternative: instead of the per-provider keys above, supply a
# single JSON object of credentials. The runner bootstraps its SecretManager
# from it on startup, so one variable carries every provider's key/base/token.
#   TOLOKAFORGE_SECRETS_JSON={"OPENROUTER_API_KEY":"sk-...","OPENAI_API_KEY":"sk-..."}
TOLOKAFORGE_SECRETS_JSON=
