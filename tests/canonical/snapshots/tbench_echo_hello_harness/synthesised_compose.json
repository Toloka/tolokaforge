{
  "services": {
    "db-service": {
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "start_period": "3s",
        "test": [
          "CMD-SHELL",
          "curl -fs http://localhost:8000/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "tolokaforge-db-service:local",
      "ports": [
        "8000"
      ]
    },
    "main": {
      "build": {
        "context": ".",
        "dockerfile": "_harness/harness.Dockerfile"
      },
      "command": [
        "sh",
        "-c",
        "sleep infinity"
      ],
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_main",
      "environment": [
        "TEST_DIR=/tests",
        "ANTHROPIC_API_KEY=${TBENCH_PROVIDER_ANTHROPIC_API_KEY}",
        "ANTHROPIC_BASE_URL=${TBENCH_PROVIDER_ANTHROPIC_BASE_URL}",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
        "CLAUDE_CONFIG_DIR=/root/.claude",
        "IS_SANDBOX=1"
      ],
      "image": "tbench-echo-hello:local-claude-code-2.1.233",
      "volumes": [
        "./tests:/tests",
        "./_logs:/logs"
      ]
    },
    "main-base": {
      "build": {
        "context": "./environment"
      },
      "image": "tbench-echo-hello:local",
      "profiles": [
        "tolokaforge-build"
      ]
    },
    "runner": {
      "depends_on": {
        "db-service": {
          "condition": "service_healthy"
        },
        "main": {
          "condition": "service_started"
        }
      },
      "environment": {
        "DB_SERVICE_URL": "http://db-service:8000"
      },
      "healthcheck": {
        "interval": "2s",
        "retries": 30,
        "start_period": "3s",
        "test": [
          "CMD",
          "bash",
          "-c",
          "echo > /dev/tcp/127.0.0.1/50051"
        ],
        "timeout": "3s"
      },
      "image": "tolokaforge-runner:local",
      "ports": [
        "50051"
      ]
    }
  }
}
