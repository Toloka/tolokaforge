{
  "services": {
    "main": {
      "build": {
        "context": ".",
        "dockerfile": "_harness/harness.Dockerfile"
      },
      "command": [
        "sh",
        "-c",
        "sleep infinity"
      ],
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_main",
      "environment": [
        "TEST_DIR=/tests",
        "ANTHROPIC_API_KEY=${TBENCH_PROVIDER_ANTHROPIC_API_KEY}",
        "ANTHROPIC_BASE_URL=${TBENCH_PROVIDER_ANTHROPIC_BASE_URL}",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
        "CLAUDE_CONFIG_DIR=/root/.claude",
        "IS_SANDBOX=1"
      ],
      "image": "tbench-echo-hello-skills:local-claude-code-2.1.233",
      "volumes": [
        "./tests:/tests",
        "./_logs:/logs"
      ]
    },
    "main-base": {
      "build": {
        "context": "./environment"
      },
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_main-base",
      "image": "tbench-echo-hello-skills:local",
      "profiles": [
        "tolokaforge-build"
      ]
    }
  }
}
