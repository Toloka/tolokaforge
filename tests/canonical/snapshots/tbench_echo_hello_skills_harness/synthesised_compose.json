{
  "services": {
    "main": {
      "build": {
        "context": ".",
        "dockerfile": "_harness/harness.Dockerfile"
      },
      "command": [
        "sh",
        "-c",
        "sleep infinity"
      ],
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_main",
      "environment": [
        "ANTHROPIC_API_KEY=${TBENCH_PROVIDER_ANTHROPIC_API_KEY}",
        "ANTHROPIC_BASE_URL=${TBENCH_PROVIDER_ANTHROPIC_BASE_URL}",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
        "CLAUDE_CONFIG_DIR=/root/.claude",
        "IS_SANDBOX=1"
      ],
      "image": "tbench-echo-hello-skills:local-claude-code-2.1.233-e211d3d2",
      "volumes": [
        "./_logs:/logs"
      ]
    },
    "main-base": {
      "build": {
        "context": "./environment"
      },
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_main-base",
      "image": "tbench-echo-hello-skills:local",
      "profiles": [
        "tolokaforge-build"
      ]
    },
    "tests-vault": {
      "build": {
        "context": ".",
        "dockerfile": "_harness/harness.Dockerfile"
      },
      "container_name": "tbench_${TOLOKAFORGE_TRIAL_SLUG}_tests-vault",
      "entrypoint": [
        "sh",
        "-c",
        "sleep infinity"
      ],
      "healthcheck": {
        "interval": "2s",
        "retries": 3,
        "start_period": "0s",
        "test": [
          "CMD-SHELL",
          "true"
        ],
        "timeout": "2s"
      },
      "image": "tbench-echo-hello-skills:local-claude-code-2.1.233-e211d3d2",
      "network_mode": "none",
      "user": "root",
      "volumes": [
        "./tests:/tests:ro"
      ]
    }
  }
}
