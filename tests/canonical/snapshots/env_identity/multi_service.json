{
  "network_policy": "no_internet",
  "runner_service": "runner",
  "services": {
    "app-db": {
      "dsns": [],
      "image": "postgres:16",
      "isolation": "reset",
      "mounts": [
        "/docker-entrypoint-initdb.d/init.sql:ro"
      ],
      "pinned": true,
      "reset_seed": "baseline"
    },
    "app-service": {
      "dsns": [
        "postgresql://app:***@app-db:5432/mfg"
      ],
      "image": "tolokaforge-runner:0.5.0",
      "isolation": "shared",
      "mounts": [
        "/srv/app/main.py:ro"
      ],
      "pinned": true,
      "reset_seed": null
    },
    "runner": {
      "dsns": [
        "http://db-service:8000"
      ],
      "image": "tolokaforge-runner:0.5.0",
      "isolation": "shared",
      "mounts": [],
      "pinned": true,
      "reset_seed": null
    }
  }
}
