# TEMPORARILY SKIPPED - renamed from task.yaml so the wire-probe glob `**/task.yaml` does not
# collect it. Reason: some provider routes (observed on google/gemini-3.1-pro-preview) return an
# unrecoverable error (native_finish_reason='error') when the model emits parallel tool calls,
# which trips the observe infra gate -> a false needs-human. Parallel calls are non-critical
# (arena tasks are sequential-completable) and this probe deliberately over-elicits them.
# RE-ENABLE (rename back to task.yaml) once the model preset can force sequential calls
# (`parallel_tool_calls: false` param) or the gate is determinism-aware for concentrated,
# non-critical provider errors.
task_id: "record_parallel_calls"
name: "Wire-probe: parallel tool calls (no synthetic wrapper)"
description: >
  Non-scoring wire-shape probe. Elicits the multi_tool_use.parallel synthetic-wrapper hallucination + parallel-call id/index collision: the model should emit N independent top-level tool_calls, not one wrapper call.
domain: ../../_shared/domain.yaml
max_turns: 3

initial_user_message: >
  Look up information on three topics at once: alpha, beta, and gamma. Then you're done.

initial_state: {}

tools:
  agent:
    enabled:
      - get_info

user_simulator:
  scripted_flow:
    - role: user
      content: "###STOP###"

metadata:
  expected_failure_modes:
    - parallel_wrapper
    - parallel_id_collision
  tags:
    - smoke
    - wire-probe
    - non-scoring

grading: "grading.yaml"
